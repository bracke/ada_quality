{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ada-quality/findings-v1.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "findings"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "findings" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["indicator", "rule", "severity", "message", "path", "line", "fingerprint"],
        "properties": {
          "indicator": { "type": "string" }, "rule": { "type": "string" },
          "severity": { "type": "string" }, "message": { "type": "string" },
          "path": { "type": "string" }, "line": { "type": "integer", "minimum": 0 },
          "fingerprint": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
