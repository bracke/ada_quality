{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ada-quality/metric-trends-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "project_id", "series"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "metric-trends" },
    "project_id": { "type": "integer", "minimum": 1 },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["indicator", "unit", "points"],
        "properties": {
          "indicator": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$" },
          "unit": { "type": "string", "minLength": 1 },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["run_id", "value"],
              "properties": {
                "run_id": { "type": "integer", "minimum": 1 },
                "value": { "type": "integer" }
              }
            }
          }
        }
      }
    }
  }
}
