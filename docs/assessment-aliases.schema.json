{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ada-quality/assessment-aliases-v1.schema.json",
  "type": "object", "required": ["schema_version", "kind", "aliases"],
  "properties": {
    "schema_version": { "const": 1 }, "kind": { "const": "assessment-aliases" },
    "page": { "type": "object", "additionalProperties": false,
      "required": ["total", "offset", "limit", "snapshot"], "properties": {
        "total": { "type": "integer", "minimum": 0 }, "offset": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 0 }, "snapshot": { "type": "integer", "minimum": 0 },
        "next_cursor": { "type": "string", "pattern": "^(v1:[0-9]+|v2:[0-9]+:[0-9]+|v3:[0-9]+:[0-9]+:[0-9]+|v4:[0-9]+:[0-9]+:[0-9]+:[0-9]+|v5:[0-9]+:[0-9]+:[0-9]+:[0-9]+:[0-9]+)$" } } },
    "aliases": { "type": "array", "items": { "type": "object",
      "required": ["name", "assessment_id"], "properties": {
        "name": { "type": "string", "minLength": 1 },
        "assessment_id": { "type": "integer", "minimum": 1 } }, "additionalProperties": false } }
  }, "additionalProperties": false
}
