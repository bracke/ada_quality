{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://example.invalid/ada-quality/policy-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "source", "fingerprint", "values"],
  "properties": { "schema_version": { "const": 1 }, "kind": { "const": "policy" }, "source": { "type": "string" },
    "fingerprint": { "type": "string" }, "values": { "$ref": "#/$defs/values" } },
  "$defs": { "values": { "type": "object", "additionalProperties": false,
    "required": ["coverage_minimum_basis_points", "maximum_source_lines", "maximum_complexity", "process_timeout_seconds", "maximum_output_bytes", "require_clean_worktree"],
    "properties": { "coverage_minimum_basis_points": { "type": "integer", "minimum": 0, "maximum": 10000 },
      "maximum_source_lines": { "type": "integer", "minimum": 1 }, "maximum_complexity": { "type": "integer", "minimum": 1 },
      "process_timeout_seconds": { "type": "integer", "minimum": 1 }, "maximum_output_bytes": { "type": "integer", "minimum": 1 },
      "require_clean_worktree": { "type": "boolean" } } } }
}
