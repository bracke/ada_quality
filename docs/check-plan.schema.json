{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ada-quality/check-plan-v1.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "projects"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "check-plan" },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "project_id", "path", "source_fingerprint", "policy_fingerprint",
          "toolchain_fingerprint", "reuse_eligible", "action"
        ],
        "properties": {
          "project_id": { "type": "integer", "minimum": 1 },
          "path": { "type": "string", "minLength": 1 },
          "source_fingerprint": { "type": "string", "minLength": 1 },
          "policy_fingerprint": { "type": "string", "minLength": 1 },
          "toolchain_fingerprint": { "type": "string" },
          "reuse_eligible": { "type": "boolean" },
          "action": { "enum": ["assess", "reuse"] },
          "assessment_id": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
