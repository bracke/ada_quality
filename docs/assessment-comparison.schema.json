{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ada-quality/assessment-comparison-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "project_id", "status", "baseline_id", "current_id", "policy_changed", "changes"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "assessment-comparison" },
    "project_id": { "type": "integer", "minimum": 1 },
    "status": {
      "enum": ["comparison-available", "no-assessments", "no-baseline", "current-incomplete", "no-completed-baseline", "toolchain-changed", "no-compatible-baseline"]
    },
    "baseline_id": { "type": "integer", "minimum": 0 },
    "current_id": { "type": "integer", "minimum": 0 },
    "policy_changed": { "type": "boolean" },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["indicator", "change", "before", "after"],
        "properties": {
          "indicator": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$" },
          "change": {
            "enum": ["new-violation", "worsened-metric", "increased-severity", "failed-gate", "lost-evidence", "introduced-finding", "reintroduced-finding", "policy-induced-change"]
          },
          "before": { "type": "string" },
          "after": { "type": "string" }
        }
      }
    }
  }
}
