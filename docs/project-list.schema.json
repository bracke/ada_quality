{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ada-quality/project-list-v1.schema.json",
  "type": "object", "required": ["schema_version", "kind", "projects"],
  "properties": {
    "schema_version": { "const": 1 }, "kind": { "const": "project-list" },
    "page": { "type": "object", "additionalProperties": false,
      "required": ["total", "offset", "limit", "snapshot"], "properties": {
        "total": { "type": "integer", "minimum": 0 }, "offset": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 0 }, "snapshot": { "type": "integer", "minimum": 0 },
        "next_cursor": { "type": "string", "pattern": "^(v1:[0-9]+|v2:[0-9]+:[0-9]+|v3:[0-9]+:[0-9]+:[0-9]+|v4:[0-9]+:[0-9]+:[0-9]+:[0-9]+|v5:[0-9]+:[0-9]+:[0-9]+:[0-9]+:[0-9]+)$" } } },
    "projects": { "type": "array", "items": { "type": "object",
      "required": ["id", "path", "enabled", "removed"],
      "properties": { "id": { "type": "integer", "minimum": 1 }, "path": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" }, "uniqueItems": true },
        "enabled": { "type": "boolean" }, "removed": { "type": "boolean" } },
      "additionalProperties": false } }
  }, "additionalProperties": false
}
