{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ada-quality/archive-v2.schema.json",
  "title": "Ada Quality persistent archive v2",
  "type": "object",
  "required": [
    "schema_version",
    "projects",
    "assessments",
    "results",
    "measurements",
    "findings",
    "executions",
    "events",
    "comparisons",
    "regressions"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "projects": { "type": "array" },
    "assessments": { "type": "array" },
    "results": { "type": "array" },
    "measurements": { "type": "array" },
    "findings": { "type": "array" },
    "executions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assessment_id",
          "command",
          "exit_code",
          "id",
          "output_bytes",
          "output_digest",
          "status",
          "tool",
          "truncated"
        ],
        "properties": {
          "assessment_id": { "type": "integer", "minimum": 1 },
          "command": { "type": "string" },
          "exit_code": { "type": "integer" },
          "id": { "type": "integer", "minimum": 1 },
          "output_bytes": { "type": "integer", "minimum": 0 },
          "output_digest": { "type": "string" },
          "status": { "enum": ["tool-completed", "tool-timed-out", "tool-spawn-error"] },
          "tool": { "type": "string", "minLength": 1 },
          "truncated": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "events": { "type": "array" },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["project_id", "status", "current_id", "baseline_id", "policy_changed"],
        "properties": {
          "project_id": { "type": "integer", "minimum": 1 },
          "status": {
            "enum": [
              "comparison-available",
              "no-assessments",
              "no-baseline",
              "current-incomplete",
              "no-completed-baseline",
              "toolchain-changed",
              "no-compatible-baseline"
            ]
          },
          "current_id": { "type": "integer", "minimum": 0 },
          "baseline_id": { "type": "integer", "minimum": 0 },
          "policy_changed": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["project_id", "baseline_id", "current_id", "indicator", "kind", "before", "after"],
        "properties": {
          "project_id": { "type": "integer", "minimum": 1 },
          "baseline_id": { "type": "integer", "minimum": 1 },
          "current_id": { "type": "integer", "minimum": 1 },
          "indicator": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$" },
          "kind": { "type": "string" },
          "before": { "type": "string" },
          "after": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
