with "../ada_quality.gpr";
with "aunit";

project Ada_Quality_Tests is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("ada_quality_tests.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatyM120", "-gnata", "-gnatwa", "-gnatVa");
   end Compiler;
end Ada_Quality_Tests;
