with "aunit";
with "database";
with "project_tools";
with "jsonlib";
with "terminal_styles";
with "messages";
with "regexp";

project Coverage is
   Coverage_Root := external ("ADA_QUALITY_COVERAGE_ROOT", ".");

   for Languages use ("Ada");
   for Source_Dirs use ("src", "../src");
   for Object_Dir use Coverage_Root & "/obj";
   for Exec_Dir use Coverage_Root & "/bin";
   for Main use ("ada_quality_tests.adb", "ada_quality_cli.adb", "ada_quality_check_all.adb");
   for Create_Missing_Dirs use "True";

   Coverage_Switches := ("-fprofile-arcs", "-ftest-coverage");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-g", "-O0", "-gnat2022", "-gnatyM120", "-gnata") & Coverage_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      for Switches ("Ada") use Coverage_Switches;
   end Linker;

   package Builder is
      for Executable ("ada_quality_cli.adb") use "ada-quality";
      for Executable ("ada_quality_check_all.adb") use "check_all";
   end Builder;
end Coverage;
